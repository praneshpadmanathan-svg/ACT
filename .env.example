# Supabase — optional.
#
# Leave these unset and the app runs completely in local-only guest mode:
# progress saves to the browser and nothing is sent anywhere. Set them to
# turn on accounts and cross-device sync.
#
# Copy this file to `.env` and fill in the values from your Supabase project
# dashboard under Settings -> API. The anon/publishable key is designed to be
# exposed in a browser bundle; never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

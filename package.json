{
  "name": "act-command",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Gamified prep for the 2025+ Enhanced ACT — study notes, adaptive drills, full-length tests and a ranked progression through four subject roads.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && npm run check:tokens && npm run check:glyphs && npm run lint && npm run test:run && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:content": "node scripts/check-content.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "supabase:doctor": "node scripts/supabase-doctor.mjs",
    "build:art": "node scripts/build-art.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "build:icons": "node scripts/build-icons.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:heroes": "node scripts/build-heroes.mjs",
    "build:ranks": "node scripts/build-ranks.mjs",
    "build:foliage": "node scripts/build-foliage.mjs",
    "build:bosses": "node scripts/build-bosses.mjs",
    "build:loading": "node scripts/build-loading.mjs",
    "build:scenes": "node scripts/build-scenes.mjs",
    "build:props": "node scripts/build-props.mjs",
    "build:regions": "node scripts/build-regions.mjs",
    "build:surround": "node scripts/build-surround.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}

{
  "name": "act-command",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Gamified prep for the 2025+ Enhanced ACT — study notes, adaptive drills, full-length tests and a world-map progression system.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:anim && npm run check:content && npm run test:run && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:anim": "node scripts/check-map-animations.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build:art": "node scripts/build-art.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
